        self.insert_entry = self._entry()
        self.insert_spin = self._spin(0, -256, 256)
        self.insert_entry.connect("notify::has-focus", lambda w, _pspec: self.insert_radio.set_active(True) if w.has_focus() else None)
        self.insert_spin.connect("notify::has-focus", lambda w, _pspec: self.insert_radio.set_active(True) if w.has_focus() else None)
        row1.append(self.insert_radio)
        row1.append(self.insert_entry)
        row1.append(Gtk.Label(label=_("at position")))
        row1.append(self.insert_spin)

        row2 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.delete_from = self._spin(0, -256, 256)
        self.delete_to = self._spin(1, -256, 256)
        self.delete_from.connect("notify::has-focus", lambda w, _pspec: self.delete_radio.set_active(True) if w.has_focus() else None)
        self.delete_to.connect("notify::has-focus", lambda w, _pspec: self.delete_radio.set_active(True) if w.has_focus() else None)
        row2.append(self.delete_radio)
        row2.append(self.delete_from)
        row2.append(Gtk.Label(label=_("and")))
