    def _show_message(self, title: str, message: str) -> None:
        dialog = Gtk.Window(transient_for=self, modal=True, title=title)
        dialog.set_default_size(440, 180)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
